<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <!-- Writes config/deploy.json from MSI properties (centralized push). No secrets. -->
    <CustomAction
      Id="CA_WriteDeployConfig"
      Directory="SystemFolder"
      ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[AgentDir]scripts\write-deploy-config.ps1&quot; -DataDir &quot;[CommonAppDataFolder]CUSA&quot; -Address &quot;[MANAGER_ADDRESS]&quot; -Port [MANAGER_PORT] -EnrollmentPort [ENROLLMENT_PORT]"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <CustomAction
      Id="CA_CreateProgramData"
      Directory="SystemFolder"
      ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[AgentDir]scripts\init-programdata.ps1&quot; -DataDir &quot;[CommonAppDataFolder]CUSA&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="check" />

    <!-- Decommission purge on uninstall when PURGE_DATA=1 -->
    <CustomAction
      Id="CA_PurgeProgramData"
      Directory="SystemFolder"
      ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[AgentDir]scripts\purge-programdata.ps1&quot; -DataDir &quot;[CommonAppDataFolder]CUSA&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
  </Fragment>
</Wix>
