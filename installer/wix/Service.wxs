<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>
    <Component Id="ServiceHostComponent" Directory="AgentDir" Guid="*">
      <File Id="ServiceHostExe" Source="$(var.BuildRoot)\agent\cusa-service-host.exe" KeyPath="yes" />

      <ServiceInstall
        Id="CUSAAgentInstall"
        Name="CUSAAgent"
        DisplayName="CUSA Unified Security Agent"
        Description="CyberSIO Unified Security Agent endpoint security and telemetry service."
        Type="ownProcess"
        Start="auto"
        Account="LocalSystem"
        ErrorControl="normal"
        Vital="yes" />

      <ServiceControl
        Id="CUSAAgentControl"
        Name="CUSAAgent"
        Start="install"
        Stop="both"
        Remove="uninstall"
        Wait="yes" />
    </Component>
  </Fragment>

</Wix>
